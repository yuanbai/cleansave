{
  "name": "cleansave",
  "version": "0.1.0",
  "private": true,
  "description": "A local social-media library for people and agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "cleansave": "dist/cli.js"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "integrations",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "pnpm build && concurrently -k \"tsx watch apps/server/src/cli.ts --dev\" \"vite --config apps/web/vite.config.ts\"",
    "build:packages": "tsc -b",
    "build": "pnpm build:packages && vite build --config apps/web/vite.config.ts && node --import tsx scripts/package.ts",
    "start": "node dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "pnpm build:packages && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:live": "node --import tsx scripts/live.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.1.1",
    "ipaddr.js": "2.5.0",
    "kysely": "0.29.6",
    "tough-cookie": "6.0.2",
    "undici": "8.12.1",
    "zod": "4.6.7",
    "playwright-core": "1.64.1",
    "youtubei.js": "18.1.0",
    "quickjs-emscripten": "0.32.0",
    "mediabunny": "1.61.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "5.104.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.57.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "@cleansave/contracts": "workspace:*",
    "@cleansave/core": "workspace:*",
    "@cleansave/resolvers": "workspace:*",
    "@cleansave/storage": "workspace:*",
    "@cleansave/client": "workspace:*",
    "@cleansave/mcp": "workspace:*"
  }
}
